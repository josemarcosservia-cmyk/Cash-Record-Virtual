# Variables de Entorno - EDITA ESTE ARCHIVO CON TUS VALORES
# Este archivo es un ejemplo. Crea un archivo .env.local con tus valores reales.
# IMPORTANTE: .env.local está en .gitignore y no se sube a GitHub (SEGURO)

# Token de GitHub para sincronización de productos de carnicería
# Obtén tu token en: https://github.com/settings/tokens
# Solo necesita permisos: repo
VITE_GITHUB_TOKEN_CARNICERIA=tu_token_aqui

# Token de GitHub para sincronización de productos de vinos (opcional)
VITE_GITHUB_TOKEN_VINOS=tu_token_vinos_aqui

# Propietario del repositorio
VITE_GITHUB_OWNER=josemarcosservia-cmyk

# Nombre del repositorio
VITE_GITHUB_REPO=Cash-Record-Virtual
